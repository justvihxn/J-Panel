# Justvihxn control plane
DISCORD_TOKEN=
BOT_NAME=Justvihxn
BOT_DEVELOPER=Justvihxn
BOT_VERSION=11.3-DOCKER
PREFIX=!
MAIN_ADMIN_ID=
VPS_USER_ROLE_ID=0
YOUR_SERVER_IP=127.0.0.1

# Docker VPS defaults
DEFAULT_STORAGE_POOL=local
DEFAULT_VPS_EXPIRATION_DAYS=30
PUBLIC_VPS_ENABLED=true
PUBLIC_VPS_MAX_RAM=4
PUBLIC_VPS_MAX_CPU=2
PUBLIC_VPS_MAX_DISK=50
PUBLIC_VPS_MAX_PER_USER=1
PUBLIC_VPS_MAX_PER_IP=3
HOST_MOTD=

# WebSSH
WEBSSH_ENABLED=true
WEBSSH_PORT=6767
WEBSSH_SERVER_IP=0.0.0.0
WEBSSH_URL_FORMAT=http://{SERVER_IP}:{PORT}
WEB_SESSION_SECRET=
WEB_COOKIE_SECURE=true

# Discord OAuth website login
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://free-vps.example.com/oauth/callback

# Host port forwarding
PORT_RANGE_START=20000
PORT_RANGE_END=50000
PORT_MAX_PER_VPS=20
PORT_ALLOW_CUSTOM=false

# Optional payments/webhooks
JUSTVIHXN_PUBLIC_URL=
PAYMENT_GATEWAYS=upi
DEFAULT_GATEWAY=upi
PAYMENT_WEBHOOK_HOST=127.0.0.1
PAYMENT_WEBHOOK_PORT=8787
UPI_ID=
UPI_NAME=Justvihxn
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
